{
  "name": "dsh-unreal-agentlink",
  "version": "0.1.0",
  "description": "DSH plugin bridging the UnrealAgentLink editor protocol — pure bridge: DSH's native agent plans, this plugin only exposes UE editor capabilities",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm run typecheck && npm test && node scripts/check-catalog.mjs && node scripts/gen-docs.mjs --check && node scripts/normalize-doc-headers.mjs --check && node scripts/normalize-doc-links.mjs --check",
    "docs": "node scripts/gen-docs.mjs && node scripts/normalize-doc-headers.mjs && node scripts/normalize-doc-links.mjs",
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "prepare": "npm run clean && npm run build",
    "prepack": "npm run clean && npm run build"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "unreal",
    "unrealengine",
    "unrealagentlink",
    "uebox",
    "bridge"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-attachment": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-fs": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-jobs": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-scope": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-user-approval": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-util-values": "^0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-jobs": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-jobs": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-jobs-local": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-scope": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-user-approval": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-util-values": "0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.5.13",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
